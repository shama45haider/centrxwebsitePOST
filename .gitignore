# Public repo (centrx.co): only the marketing site goes up. Anything not listed here stays on this computer.
/*
!/.gitignore
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/static.yml

!/index.html
!/404.html
!/features.html
!/pricing.html
!/contact.html
!/privacy.html
!/terms.html

!/assets/
/assets/*
!/assets/css/
/assets/css/*
!/assets/css/tokens.css
!/assets/css/base.css
!/assets/css/components.css
!/assets/css/site.css
!/assets/js/
/assets/js/*
!/assets/js/site.js
!/assets/js/people.js
!/assets/js/core/
/assets/js/core/*
!/assets/js/core/ns.js
!/assets/js/core/icons.js
!/assets/js/data/
/assets/js/data/*
!/assets/js/data/plans.js
!/assets/brand/
/assets/brand/*
!/assets/brand/centrx-mark.svg
!/assets/brand/favicon-32.png
!/assets/brand/apple-touch-icon.png

# Secrets never belong in git, even inside a listed folder
.env
.env.*
*.pem
*.key
